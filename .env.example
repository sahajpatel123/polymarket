# Copy to .env and fill in. Never commit .env.

# Signer private key (hex, with or without 0x)
PK=

# Polymarket funder / deposit address (holds pUSD and positions).
# For signature_type 1/2/3 this is the proxy/deposit wallet, NOT the signing EOA.
BROWSER_ADDRESS=

# ── V3: the SINGLE CAPITAL KNOB ─────────────────────────────────────
# This is the ONLY money number you set. All risk caps, per-market
# caps, daily loss kill, target growth, etc. are derived from this
# as percentages. Change this to change your entire risk envelope.
# Examples: 30, 100, 500, 5000. Set to 0 to disable live trading
# (paper / dry-run mode).
POLYMAKER_CAPITAL_USDC=0

# Optional V3 risk profile (conservative | balanced | aggressive).
# Determines the multipliers on the % defaults.
# POLYMAKER_RISK_PROFILE=balanced

# Optional V3 % overrides (whole numbers OR decimals; "10" or "0.10" both work).
# Note: there is NO target/profit cap. The bot earns without ceiling.
# POLYMAKER_MAX_PER_MARKET_PCT=5
# POLYMAKER_DAILY_LOSS_KILL_PCT=10
# POLYMAKER_MAX_DRAWDOWN_KILL_PCT=25
# POLYMAKER_MAX_MARKETS=8

# ── V3: DeepSeek LLM agent — required for LLM-augmented selection,
# commentary, self-improvement, and oversight. Leave blank to disable
# LLM features (deterministic-only fallback).
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional: override model (default: deepseek-chat for fast, deepseek-reasoner for reasoning)
# DEEPSEEK_MODEL=deepseek-chat

# Polymarket Gamma API Base URL
GAMMA_BASE_URL=https://gamma-api.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# Optional overrides

# POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
# ALL_PROXY=socks5://127.0.0.1:1080
# ALERT_WEBHOOK_URL=
# Live dashboard binds loopback only; set to 1 only if you intentionally bind a LAN host
# POLYMAKER_DASHBOARD_ALLOW_REMOTE=0

# Required only to merge YES+NO via a V2 DepositWallet (signature_type 1 or 3).
# Generate with the CLOB client's create_builder_api_key.
# POLY_BUILDER_KEY=
# POLY_BUILDER_SECRET=
# POLY_BUILDER_PASSPHRASE=
# POLY_RELAYER_URL=https://relayer-v2.polymarket.com

# ── V3 Grok / xAI agent (LLM oversight + discovery) ──
# Get a key from https://console.x.ai — never commit real keys.
# XAI_API_KEY=
# Optional model override (must remain a reasoning SKU unless XAI_ALLOW_NON_REASONING=1)
# XAI_MODEL=grok-4-1-fast-reasoning
# XAI_ALLOW_NON_REASONING=0
